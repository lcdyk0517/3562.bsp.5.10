		15 00 02 01 00
		15 00 02 ee 00
		15 00 02 ea 00
		15 00 02 eb 00
		15 00 02 36 00
		05 c8 01 11
		05 14 01 29
		];
		panel-exit-sequence = [
		05 00 01 28
		05 00 01 10
		];
		
		disp_timings0: display-timings {
			native-mode = <&dsi_timing0>;
			
			/* Defaults from RG52 Mini; overridden per-device */
			dsi_timing0: timing0 {
				clock-frequency = <52000000>;
				hactive = <1024>;
				vactive = <768>;
				hfront-porch = <32>;
				hsync-len = <20>;
				hback-porch = <20>;
				vfront-porch = <8>;
				vsync-len = <4>;
				vback-porch = <6>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
		};
		
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			
			port@0 {
				reg = <0>;
				
				panel_in_dsi: endpoint {
					remote-endpoint = <&dsi_out_panel>;
				};
			};
		};
	};
	
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		
		port@1 {
			reg = <1>;
			
			dsi_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi>;
			};
		};
	};
};

&dsi_in_vp0 {
	status = "okay";
};

&rgb_in_vp0 {
	status = "okay";
};

&gpu {
	status = "okay";
	mali-supply = <&vdd_gpu>;
};

&i2c0 {
	status = "okay";
	
	rk817: pmic@20 {
		compatible = "rockchip,rk817";
		reg = <0x20>;
		interrupt-parent = <&gpio0>;
		interrupts = <3 IRQ_TYPE_LEVEL_LOW>;
		
		pinctrl-names = "default", "pmic-sleep",
		"pmic-power-off", "pmic-reset";
		pinctrl-0 = <&pmic_int>;
		pinctrl-1 = <&soc_slppin_slp>, <&rk817_slppin_slp>;
		pinctrl-2 = <&soc_slppin_gpio>, <&rk817_slppin_pwrdn>;
		pinctrl-3 = <&soc_slppin_gpio>, <&rk817_slppin_rst>;
		rockchip,system-power-controller;
		wakeup-source;
		#clock-cells = <1>;
		clock-output-names = "rk808-clkout1", "rk808-clkout2";
		/* 1: rst regs (default in codes), 0: rst the pmic */
		pmic-reset-func = <0>;
		vcc1-supply = <&vcc_sys>;
		vcc2-supply = <&vcc_sys>;
		vcc3-supply = <&vcc_sys>;
		vcc4-supply = <&vcc_sys>;
		vcc5-supply = <&vcc_sys>;
		vcc6-supply = <&vcc_sys>;
		vcc7-supply = <&vcc_sys>;
		vcc8-supply = <&vcc_sys>;
		vcc9-supply = <&dcdc_boost>;
		pwrkey {
			status = "okay";
		};
		
		pinctrl_rk8xx: pinctrl_rk8xx {
			gpio-controller;
			#gpio-cells = <2>;
			
			rk817_slppin_null: rk817_slppin_null {
				pins = "gpio_slp";
				function = "pin_fun0";
			};
			
			rk817_slppin_slp: rk817_slppin_slp {
				pins = "gpio_slp";
				function = "pin_fun1";
			};
			
			rk817_slppin_pwrdn: rk817_slppin_pwrdn {
				pins = "gpio_slp";
				function = "pin_fun2";
			};
			
			rk817_slppin_rst: rk817_slppin_rst {
				pins = "gpio_slp";
				function = "pin_fun3";
			};
			
			rk817_ts_gpio1: rk817_ts_gpio1 {
				pins = "gpio_ts";
				function = "pin_fun1";
			};
			
			rk817_pin_ts: rk817_pin_ts {
				pins = "gpio_ts";
				function = "pin_fun0";
			};
		};
		
		regulators {
			vdd_logic: DCDC_REG1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-init-microvolt = <950000>;
				regulator-ramp-delay = <6001>;
				regulator-initial-mode = <0x2>;
				regulator-name = "vdd_logic";
				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};
			
			vdd_cpu: DCDC_REG2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-init-microvolt = <1050000>;
				regulator-ramp-delay = <6001>;
				regulator-initial-mode = <0x2>;
				regulator-name = "vdd_cpu";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			
			vcc_ddr: DCDC_REG3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;
				regulator-name = "vcc_ddr";
				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};
			
			vcc_3v3: DCDC_REG4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-initial-mode = <0x2>;
				regulator-name = "vcc_3v3";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};
			
			vcca1v8_pmu: LDO_REG1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcca1v8_pmu";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};
			
			vdda_0v9: LDO_REG2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-name = "vdda_0v9";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			
			vdda0v9_pmu: LDO_REG3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-name = "vdda0v9_pmu";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};
			
			vccio_acodec: LDO_REG4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-name = "vccio_acodec";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			
			vccio_sd: LDO_REG5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vccio_sd";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			
			vcc3v3_pmu: LDO_REG6 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc3v3_pmu";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3000000>;
				};
			};
			
			vcc_1v8: LDO_REG7 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc_1v8";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			
			vcc1v8_dvp: LDO_REG8 {
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-name = "vcc1v8_dvp";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			
			vcc2v8_dvp: LDO_REG9 {
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-name = "vcc2v8_dvp";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			
			dcdc_boost: BOOST {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <4700000>;
				regulator-max-microvolt = <5400000>;
				regulator-name = "boost";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			
			otg_switch: OTG_SWITCH {
				regulator-name = "otg_switch";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};
		
		battery {
			compatible = "rk817,battery";
			ocv_table = <
			3300 3350 3400 3450 3500 3550 3600
			3650 3700 3750 3800 3850 3900 3940
			3980 4020 4060 4100 4130 4150 4170
			>;
			design_capacity = <3791>;
			design_qmax = <4000>;
			design_max_voltage = <4350>;
			sleep_enter_current = <150>;
			sleep_exit_current = <180>;
			sleep_filter_current = <100>;
			power_off_thresd = <3300>;
			zero_algorithm_vol = <3950>;
			max_soc_offset = <60>;
			monitor_sec = <5>;
			sample_res = <10>;
			bat_res = <127>;
			energy_mode = <0>;
			zero_reserve_dsoc = <10>;
			fb_temperature = <25>;
			virtual_power = <0>;
			rockchip,charger-use-pmic-plug;
			rocknix,fixed-usb-host-vbus;
		};
		
		charger {
			compatible = "rk817,charger";
			min_input_voltage = <4500>;
			max_input_current = <2500>;
			max_chrg_current = <2500>;
			max_chrg_voltage = <4350>;
			chrg_term_mode = <0>;
			chrg_finish_cur = <300>;
			virtual_power = <0>;
			sample_res = <10>;
			power_dc2otg = <0>;
			dc_det_adc = <0>;
			rockchip,charger-use-pmic-plug;
			rocknix,fixed-usb-host-vbus;
			otg5v_suspend_enable = <1>;
			extcon = <&u2phy>;
			gate_function_disable = <1>;
		};
		
		rk817_codec: codec {
			#sound-dai-cells = <0>;
			compatible = "rockchip,rk817-codec";
			clocks = <&mclkout_sai0>;
			clock-names = "mclk";
			assigned-clocks = <&mclkout_sai0>;
			assigned-clock-rates = <12288000>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2s0m0_mclk>;
			mic-in-differential;
			use-ext-amplifier;
			spk-ctl-gpios = <&gpio0 RK_PA7 GPIO_ACTIVE_HIGH>;
			hp2extamplifier;
			hp-volume = <15>;
			spk-volume = <6>;
			hp-mute-delay-ms = <100>;
			status = "okay";
		};
	};
};


&i2c3 {
	status = "okay";
	clock-frequency = <400000>;
	
	rk628: rk628@50 {
		status = "okay";
		compatible = "rockchip,rk628";
		reg = <0x50>;
		#sound-dai-cells = <0>;
		interrupt-parent = <&gpio3>;
		interrupts = <RK_PB3 IRQ_TYPE_LEVEL_HIGH>;
		enable-gpios = <&gpio3 RK_PB6 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&rk628_reset &refclk_pins>;
		assigned-clocks = <&cru CLK_PMU1_WIFI>;
		assigned-clock-rates = <24000000>;
		clocks = <&cru CLK_PMU1_WIFI>;
		clock-names = "soc_24M";
		mode-sync-pol = <0>;
		rk628-rgb-in;
		rk628-hdmi-out;
		
		port {
			/*
			* Cannot reuse the dtsi's "rgb_in_hdmi" label: that one
			* still exists on the (now disabled) i2c4 node and DTC
			* rejects duplicate labels.  The RGB side below is
			* patched by absolute path instead, and the dtsi's i2c4
			* node is disabled so nothing else points at it.
			*/
			ngp_rgb_in_hdmi: endpoint {
				remote-endpoint = <&rgb_out_hdmi>;
			};
		};
	};
};

&i2c4 {
	status = "disabled";
};

&sai2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2s2m0_lrck &i2s2m0_sclk &i2s2m0_sdo>;
};

&jpegd {
	status = "okay";
};

&jpegd_mmu {
	status = "okay";
};

&mpp_srv {
	status = "okay";
};

/* pwm4 is enabled per-device -- only the RG52 Mini uses it (chassis fan).
* RG43H Pro has no fan, so we don't claim GPIO1_D1 there. */

&pwm5 {
	status = "okay";
};

/* pwm6 left disabled — drives vdd_npu, NPU is unused */

&pwm7 {
	status = "okay";
};

/* uart1 (ttyS1) -- TX-only serial link to the analog-stick RGB LED MCU.
* Enabled on both devices; the LED feature itself is OFF by default (the
* vcc-led rail stays down until the user turns it on from Options > LED
* Settings). Only uart1_tx is muxed (see mcu_uart_tx) so the RG52 Mini fan
* keeps GPIO1_D1. /usr/local/bin/ledctl drives it at 9600 8N1. */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&mcu_uart_tx>;
	status = "disabled";
};

&rga2 {
	status = "okay";
};

&rga2_mmu {
	status = "okay";
};

/* rknpu + rknpu_mmu left disabled — NPU is unused, saves power */

&rkvdec {
	status = "okay";
};

&rkvdec_mmu {
	status = "okay";
};

&rkvenc {
	status = "okay";
};

&rkvenc_mmu {
	status = "okay";
};

&rng {
	status = "okay";
};

&route_dsi {
	status = "okay";
};

&route_rgb {
	status = "okay";
	connect = <&vp0_out_rgb>;
	bridge = <&rk628>;
};

&rgb {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&ngp_vo_pins>;
	
	ports {
		port@0 {
			rgb_in_vp0: endpoint@0 {
				status = "okay";
			};
		};
		port@1 {
			reg = <1>;
			
			rgb_out_hdmi: endpoint {
				remote-endpoint = <&ngp_rgb_in_hdmi>;
			};
		};
	};
};

&sai0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2s0m0_lrck
	&i2s0m0_sclk
	&i2s0m0_sdi0
	&i2s0m0_sdo0>;
};

&sai1 {
	/* 原厂固件也禁用 SAI1: i2s1m0 引脚与 rgb 显示冲突 (gpio3-22),
	* 本机 HDMI 音频走 SAI2, SAI1 无消费者。 */
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&i2s1m0_lrck
	&i2s1m0_sclk
	&i2s1m0_sdi0
	&i2s1m0_sdo0>;
};

&saradc0 {
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

&saradc1 {
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

&sdhci {
	bus-width = <8>;
	no-sdio;
	no-sd;
	non-removable;
	max-frequency = <200000000>;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	full-pwr-cycle-in-suspend;
	status = "okay";
};

&sdmmc0 {
	no-sdio;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	vmmc-supply = <&vcc_sd>;
	vqmmc-supply = <&vccio_sd>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
	status = "okay";
	max-frequency = <50000000>;
};

&sdmmc1 {
	no-sdio;
	no-mmc;
	bus-width = <4>;
	disable-wp;
	cap-sd-highspeed;
	cap-mmc-highspeed;
	disable-wp;
	broken-cd;
	vqmmc-supply = <&vccio_sd>;
	max-frequency = <50000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_cmd &sdmmc1_clk &sdmmc1_det>;
	status = "okay";
};

&tsadc {
	status = "okay";
};

&u2phy {
	status = "okay";
};

&u2phy_host {
	vbus-supply = <&vcc5v0_usb_host>;
};

&u2phy_otg {
	status = "okay";
};

&usb_host0_ehci {
	vbus-supply = <&vcc5v0_usb_host>;
	status = "okay";
};

&usb_host0_ohci {
	vbus-supply = <&vcc5v0_usb_host>;
	status = "okay";
};

&usbdrd30 {
	status = "okay";
};

&usbdrd_dwc3 {
	status = "okay";
	dr_mode = "otg";
	extcon = <&u2phy>;
	maximum-speed = "high-speed";
	phys = <&u2phy_otg>;
	phy-names = "usb2-phy";
	snps,dis_u2_susphy_quirk;
	snps,usb2-lpm-disable;
	vbus-supply = <&vcc5v0_usb_otg>;
};

&video_phy {
	status = "okay";
};

&vop {
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

/* VOP port@0 — DSI connector: set plane-mask for all dArkOS devices */
&vp0 {
	rockchip,plane-mask = <0x30c>;
	rockchip,primary-plane = <0x02>;
};

&spi0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&ngp_spi0_pins>;
	
	spi_dev@0 {
		compatible = "rockchip,spidev";
		reg = <0>;
		spi-max-frequency = <8000000>;
	};
};

/* ---- Pin control ------------------------------------------------------ */

&pinctrl {
	headphone {
		hp_det: hp-det {
			rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	vo {
		ngp_vo_pins: ngp-vo-pins {
			rockchip,pins =
			<4 RK_PB7 1 &pcfg_pull_none>,
			<4 RK_PA4 1 &pcfg_pull_none>,
			<4 RK_PA5 1 &pcfg_pull_none>,
			<4 RK_PB2 1 &pcfg_pull_none>,
			<3 RK_PC4 1 &pcfg_pull_none>,
			<3 RK_PC5 1 &pcfg_pull_none>,
			<3 RK_PC6 1 &pcfg_pull_none>,
			<3 RK_PC7 1 &pcfg_pull_none>,
			<3 RK_PD0 1 &pcfg_pull_none>,
			<4 RK_PA6 1 &pcfg_pull_none>,
			<4 RK_PA7 1 &pcfg_pull_none>,
			<3 RK_PD1 1 &pcfg_pull_none>,
			<3 RK_PD2 1 &pcfg_pull_none>,
			<3 RK_PD3 1 &pcfg_pull_none>,
			<3 RK_PD4 1 &pcfg_pull_none>,
			<3 RK_PD5 1 &pcfg_pull_none>,
			<3 RK_PD6 1 &pcfg_pull_none>,
			<4 RK_PB0 1 &pcfg_pull_none>,
			<4 RK_PB1 1 &pcfg_pull_none>,
			<4 RK_PB3 1 &pcfg_pull_none>,
			<3 RK_PD7 1 &pcfg_pull_none>,
			<4 RK_PA0 1 &pcfg_pull_none>,
			<4 RK_PA1 1 &pcfg_pull_none>,
			<4 RK_PA2 1 &pcfg_pull_none>,
			<4 RK_PA3 1 &pcfg_pull_none>,
			<4 RK_PB6 1 &pcfg_pull_none>,
			<4 RK_PB4 1 &pcfg_pull_none>,
			<4 RK_PB5 1 &pcfg_pull_none>;
		};
	};
	
	lcd {
		lcd_rst_gpio: lcd-rst-gpio {
			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		ngp_lcd_pwren: ngp-lcd-pwren {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	spi0-ngp45h {
		ngp_spi0_pins: spi0m1-pins-ngp45h {
			rockchip,pins =
			<3 RK_PB5 4 &pcfg_pull_none>,
			<3 RK_PB4 4 &pcfg_pull_none>;
		};
	};
	
	sdio-pwrseq {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <0 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	
	wireless-wlan {
		wifi_host_wake_irq: wifi-host-wake-irq {
			rockchip,pins = <0 RK_PB4 RK_FUNC_GPIO &pcfg_pull_down>;
		};
		
		wifi_poweren_gpio: wifi-poweren-gpio {
			rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	rk628 {
		rk628_reset: rk628-reset {
			rockchip,pins = <3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		
		refclk_pins: refclk-pins {
			rockchip,pins = <0 RK_PA0 1 &pcfg_pull_none>;
		};
	};
	
	vcc-led {
		led_en_gpio: led-en-gpio {
			rockchip,pins = <0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	stick-led-mcu {
		/* uart1_tx_m0 (GPIO1_D2) ONLY. The stick-RGB LED MCU is a
		* write-only target (the mcu_led protocol never reads), so we
		* deliberately do NOT mux uart1_rx_m0 (GPIO1_D1). That leaves
		* GPIO1_D1 free for the RG52 Mini chassis fan (pwm4_m1), so the
		* fan and the LED MCU coexist on one UART pin pair. */
		mcu_uart_tx: mcu-uart-tx {
			rockchip,pins = <1 RK_PD2 1 &pcfg_pull_up>;
		};
	};
	
	fan {
		fan_vcc_en_gpio: fan-vcc-en-gpio {
			rockchip,pins = <0 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		
		fan_det_gpio: fan-det-gpio {
			rockchip,pins = <2 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	charge-led {
		charge_led_gpio: charge-led-gpio {
			rockchip,pins =
			<3 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>,
			<3 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	usb {
		usb_host_pwren: usb-host-pwren {
			rockchip,pins = <3 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		
		usb_otg_pwren: usb-otg-pwren {
			rockchip,pins = <3 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	buttons {
		/*
		* All 10 button GPIOs are listed here (RG52 Mini has 10,
		* RG43H Pro has 9).  The joystick driver node is per-device;
		* each button child node carries its own gpios property.
		*/
		gpio_key_pin: gpio-key-pin {
			rockchip,pins =
			<1 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>,
			<1 RK_PD4 RK_FUNC_GPIO &pcfg_pull_up>,
			<1 RK_PD1 RK_FUNC_GPIO &pcfg_pull_up>,
			<1 RK_PD2 RK_FUNC_GPIO &pcfg_pull_up>,
			<0 RK_PC3 RK_FUNC_GPIO &pcfg_pull_up>,
			<0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>,
			<2 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>,
			<2 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>,
			<0 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>,
			<0 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>,
			<0 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>,
			<0 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>,
			<0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>,
			<3 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>,
			<1 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>,
			<0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>,
			<0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>;
		};
		
		/* 主马达 GPIO3_A7 (各机型共用). 副马达/风扇轨脚位因板而异:
		* - rg52mini/rg43h: 副马达 GPIO3_B0 -> moto_r_gpio (各自 dts)
		* - ais: GPIO3_B0 是 fan_vcc 使能, 独占, 不进 moto 组
		* - ngp45ht: 单马达 GPIO0_B7 -> ngp_moto_gpio
		* 偏置用 pull_none (原厂同款): pull_up 会在 probe 前把
		* ACTIVE_HIGH 马达脚抬高 -> 上电常震. */
		moto_gpio: moto-gpio {
			rockchip,pins = <0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
