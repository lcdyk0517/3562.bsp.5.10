# dArkOS3562: AIC8800DC USB 变体 (源码自 AveyondFly/aic8800-usb), 内核树内编译。
# 逻辑对齐 vendor 外部模块 Makefile: CONFIG_USB_SUPPORT=y, 无 SDIO 文件,
# MODULE_NAME 带 _usb 后缀。

ccflags-y += -DAICWF_USB_SUPPORT
ccflags-y += -DCONFIG_USB_SUPPORT
ccflags-y += -DANDROID_PLATFORM
ccflags-y += -DCONFIG_PLATFORM_UBUNTU
ccflags-y += -DNX_VIRT_DEV_MAX=4
ccflags-y += -DNX_REMOTE_STA_MAX_FOR_OLD_IC=8
ccflags-y += -DNX_REMOTE_STA_MAX=32
ccflags-y += -DNX_MU_GROUP_MAX=62
ccflags-y += -DNX_TXDESC_CNT=64
ccflags-y += -DNX_TX_MAX_RATES=4
ccflags-y += -DNX_CHAN_CTXT_CNT=3
ccflags-y += -DCONFIG_RWNX_OLD_IPC
ccflags-y += -DCONFIG_START_FROM_BOOTROM
ccflags-y += -DCONFIG_PMIC_SETTING
ccflags-y += -DCONFIG_DPD
ccflags-y += -Wno-error

aic_load_fw_usb-y := \
	aic_bluetooth_main.o \
	aic_compat_8800d80.o \
	aic_compat_8800d80x2.o \
	aic_txrxif.o \
	aicbluetooth.o \
	aicbluetooth_cmds.o \
	aicwf_rx_prealloc.o \
	aicwf_txq_prealloc.o \
	aicwf_usb.o \
	md5.o

obj-m += aic_load_fw_usb.o

